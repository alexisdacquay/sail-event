#!/bin/sh
# Pre-commit hook: block committed secrets, gate make test on code changes.

set -e

# --- Secret check (always runs) -------------------------------------------

# Patterns that must never appear in staged content (except .env.example).
# A value is "real" when it is non-empty, not "change-me", and not "sail:sail@".
check_secrets() {
    # All staged files except .env.example
    FILES=$(git diff --cached --name-only --diff-filter=d | grep -v '^\.env\.example$') || true
    [ -z "$FILES" ] && return 0

    STAGED=$(git diff --cached -U0 -- $FILES)
    [ -z "$STAGED" ] && return 0

    FAIL=0

    # Build patterns via concatenation so this script doesn't match itself.
    SK="sk-ant""-"
    TV="tvly""-"
    PK="BEGIN PRIVATE"" KEY"

    # Bare key prefixes anywhere (these never belong in source)
    for pat in "$SK" "$TV" "$PK"; do
        HITS=$(echo "$STAGED" | grep -n "^+" | grep -F "$pat" || true)
        if [ -n "$HITS" ]; then
            echo "ERROR: secret pattern '$pat' found in staged changes:"
            echo "$HITS" | head -5
            FAIL=1
        fi
    done

    # API key assignments with a real value
    for key in ANTHROPIC_API_KEY TAVILY_API_KEY; do
        HITS=$(echo "$STAGED" | grep -n "^+" | grep -E "${key}=.+" | grep -v -E "${key}=(change-me|$)" || true)
        if [ -n "$HITS" ]; then
            echo "ERROR: $key with a real value found in staged changes:"
            echo "$HITS" | head -5
            FAIL=1
        fi
    done

    # Postgres connection string with a real password
    # Allow empty password, "change-me", or "sail" (dev placeholder)
    PG="postgre""sql"
    HITS=$(echo "$STAGED" | grep -n "^+" \
        | grep -E "${PG}(\+psycopg)?://[^:]*:[^@]+@" \
        | grep -v -E "${PG}(\+psycopg)?://[^:]*:(change-me|sail)@" \
        || true)
    if [ -n "$HITS" ]; then
        echo "ERROR: postgres connection string with real password in staged changes:"
        echo "$HITS" | head -5
        FAIL=1
    fi

    return $FAIL
}

if ! check_secrets; then
    echo ""
    echo "Commit blocked: secrets detected in staged files."
    echo "Use .env for real values; commit only placeholders."
    exit 1
fi

# --- Test gate (skippable) -------------------------------------------------

if [ "${SKIP_HOOK_TESTS:-0}" = "1" ]; then
    exit 0
fi

# Run make test only when code directories are touched
CODE_CHANGED=$(git diff --cached --name-only --diff-filter=d \
    | grep -E '^(backend/|frontend/src/|incident-response/)' || true)

if [ -n "$CODE_CHANGED" ]; then
    echo "Code files changed — running make test..."
    make test
fi
