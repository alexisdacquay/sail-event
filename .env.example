# Database connection string (compose default: postgresql+psycopg://sail:sail@postgres:5432/sail_event)
DATABASE_URL=postgresql+psycopg://sail:sail@postgres:5432/sail_event
# Secret key for signing JWT tokens (change in production)
JWT_SECRET=change-me
# Shared secret for POST /api/search/all
SEARCH_ALL_API_KEY=change-me
# Set to 1 to create a demo user on startup
SEED_DEMO=1
# Host port for the app container (default 8000)
HOST_PORT=8000
# Application environment identifier (default dev)
APP_ENV=dev
# Application version tag (default dev)
APP_VERSION=dev
# Log level for the root logger (default INFO)
LOG_LEVEL=INFO
# OTLP exporter base URL; leave empty to disable telemetry entirely
OTEL_EXPORTER_OTLP_ENDPOINT=
