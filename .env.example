# Database connection string (compose default: postgresql+psycopg://sail:sail@postgres:5432/sail_event)
DATABASE_URL=postgresql+psycopg://sail:sail@postgres:5432/sail_event
# Secret key for signing JWT tokens (change in production)
JWT_SECRET=change-me
# Shared secret for POST /api/search/all
SEARCH_ALL_API_KEY=change-me
# Set to 1 to create a demo user on startup
SEED_DEMO=1
# Host port for the app container (default 8000)
HOST_PORT=8000
# Application environment identifier (default dev)
APP_ENV=dev
# Application version tag (default dev)
APP_VERSION=dev
# Log level for the root logger (default INFO)
LOG_LEVEL=INFO
# OTLP exporter base URL; leave empty to disable telemetry entirely
OTEL_EXPORTER_OTLP_ENDPOINT=
# Search provider: "fixture" (default) or "tavily"
# SEARCH_PROVIDER=tavily
# Tavily API key (required when SEARCH_PROVIDER=tavily)
TAVILY_API_KEY=
# Maximum events kept per search run after dedup (default 50)
# MAX_EVENTS_PER_RUN=50
# Scorer: "fake" (default) or "claude" for real scoring
# SCORER=claude
# Claude model for scoring (default claude-haiku-5-5)
# SCORER_MODEL=claude-haiku-5-5
# Anthropic API key (required when SCORER=claude)
ANTHROPIC_API_KEY=
# --- Search v2 LLM adapter ---
# LLM provider: "fake" (default outside prod), "openai_compatible"
# LLM_PROVIDER=fake
# OpenAI-compatible endpoint (required when LLM_PROVIDER=openai_compatible)
# LLM_BASE_URL=https://api.deepseek.com
# LLM model name
# LLM_MODEL=deepseek-flash
# API key (required when LLM_PROVIDER=openai_compatible)
# LLM_API_KEY=
# JSON mode: "json_object" (DeepSeek) or "json_schema"
# LLM_JSON_MODE=json_object
# Fixed clock for fixtures and tests (ISO-8601); unset in prod
# FAKE_NOW=2026-10-18T12:00:00+02:00
# Max users processed per scheduled search (default 50)
# MAX_SCHEDULED_USERS=50
# Successful registrations allowed per client IP per hour (default 5)
# REGISTER_RATE_LIMIT_PER_HOUR=5
# Invite code for registration; leave empty for open registration
# REGISTRATION_CODE=
# --- Guardrails ---
# Guardrail provider: "none" (default, dev/CI) or "lakera" (prod)
# GUARDRAIL=none
# Lakera Guard API key (required when GUARDRAIL=lakera)
# LAKERA_API_KEY=
# Fallback when Lakera errors or quota exhausted: "self_check" or "none"
# GUARD_FALLBACK=self_check
# "Search now" rate limit per user per rolling hour (default 6)
# SEARCH_NOW_PER_HOUR=6
