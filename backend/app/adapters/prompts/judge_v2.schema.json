{
  "type": "object",
  "required": ["score", "reason", "fit", "is_event"],
  "additionalProperties": false,
  "properties": {
    "score": {"type": "integer"},
    "reason": {"type": "string"},
    "fit": {
      "type": "object",
      "required": ["place", "date", "topic", "budget"],
      "additionalProperties": false,
      "properties": {
        "place": {"type": "string", "enum": ["yes", "no", "unknown"]},
        "date": {"type": "string", "enum": ["yes", "no", "unknown"]},
        "topic": {"type": "string", "enum": ["yes", "no", "unknown"]},
        "budget": {"type": "string", "enum": ["yes", "no", "unknown"]}
      }
    },
    "is_event": {"type": "boolean"}
  }
}
